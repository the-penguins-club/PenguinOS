# USB Wi-Fi Dongle ZeroCD / Mode Switch Rules for PenguinOS
# Flips multi-mode USB Wi-Fi adapters from virtual CD-ROM (Windows installer) mode to active Wi-Fi NIC

# Realtek RTL8821CU, RTL8811CU, RTL8822CU, RTL8723DU, RTL8188GU / RTL8188FTV
ACTION=="add", SUBSYSTEM=="usb", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="1a2b", RUN+="/usr/sbin/usb_modeswitch -K -v 0bda -p 1a2b"
ACTION=="add", SUBSYSTEM=="usb", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="1a2c", RUN+="/usr/sbin/usb_modeswitch -K -v 0bda -p 1a2c"
ACTION=="add", SUBSYSTEM=="usb", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="b711", RUN+="/usr/sbin/usb_modeswitch -K -v 0bda -p b711"
ACTION=="add", SUBSYSTEM=="usb", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="f179", RUN+="/usr/sbin/usb_modeswitch -K -v 0bda -p f179"

# MediaTek MT7601U / MT7610U multi-mode adapters
ACTION=="add", SUBSYSTEM=="usb", ATTRS{idVendor}=="0e8d", ATTRS{idProduct}=="7610", RUN+="/usr/sbin/usb_modeswitch -K -v 0e8d -p 7610"
ACTION=="add", SUBSYSTEM=="usb", ATTRS{idVendor}=="0e8d", ATTRS{idProduct}=="2870", RUN+="/usr/sbin/usb_modeswitch -K -v 0e8d -p 2870"
